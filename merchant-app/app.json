{
  "expo": {
    "name": "中医馆商家端",
    "slug": "service-booking-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "servicebookingmerchant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#173D35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.servicebooking.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173D35"
      },
      "package": "com.example.servicebooking.merchant"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-asset", "expo-font"]
  }
}
